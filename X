local function getExecutorInfo()
    local execName = "Unknown"
    local execLevel = "Unknown"

    if identifyexecutor then
        execName = identifyexecutor()
    elseif getexecutorname then
        execName = getexecutorname()
    elseif syn and syn.get_name then
        execName = syn.get_name()
    elseif fluxus and fluxus.get_name then
        execName = fluxus.get_name()
    elseif krnl and krnl.get_name then
        execName = krnl.get_name()
    end

    if getgenv and getgenv().executor_level then
        execLevel = tostring(getgenv().executor_level)
    elseif getthreadidentity and type(getthreadidentity) == "function" then
        execLevel = tostring(getthreadidentity())
    elseif getidentity and type(getidentity) == "function" then
        execLevel = tostring(getidentity())
    elseif syn and syn.get_thread_identity then
        execLevel = tostring(syn.get_thread_identity())
    end

    return execName, execLevel
end

